{
  "name": "intelligent-pdf-reader",
  "productName": "Lexleaf",
  "version": "0.2.1",
  "private": true,
  "description": "Local-first desktop PDF reader that lets users understand unfamiliar words without leaving the document.",
  "license": "Apache-2.0",
  "author": "Lexleaf",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --build --force tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dictionary:fetch": "node scripts/dictionary/fetch-source.mjs",
    "dictionary:build": "node scripts/dictionary/build.mjs",
    "dictionary:fixture": "node scripts/dictionary/build-fixture.mjs",
    "dictionary:verify": "node scripts/dictionary/verify-reproducible.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:integration && npm run build",
    "package:win:poc": "npm run dictionary:prepare:production && npm run build && electron-builder --win dir --x64 --config electron-builder.yml && node scripts/packaging/verify-packaged-output.mjs dist/win-unpacked && electron-builder --win nsis --x64 --config electron-builder.yml",
    "package:verify:poc": "node scripts/packaging/verify-poc.mjs",
    "dictionary:verify:production": "node scripts/packaging/verify-production-dictionary.mjs",
    "verify:license-compliance": "node scripts/packaging/verify-license-compliance.mjs",
    "dictionary:prepare:production": "node scripts/packaging/prepare-production.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
